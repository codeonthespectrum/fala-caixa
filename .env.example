# Configuração do Sistema de Alertas Inteligentes para Nex (Nextar)

# Identificação da Loja e Chave PIX (para Nível 1: Cliente Sumido)
STORE_NAME="Minimercado Exemplo"
PIX_KEY="84999999999"

# Parâmetros da Funcionalidade A (Margem Oculta na Reposição)
MARGIN_THRESHOLD="0.30"
LOOKBACK_HOURS="48"
PRICE_ROUNDING_STEP="0.10"

# Parâmetros da Funcionalidade B (Régua de Fiado em 3 Níveis)
OVERDUE_MIN_DAYS="30"
CARA_DE_PAU_MAX_DAYS_SINCE_VISIT="15"
SUMIDO_MIN_DAYS_SINCE_VISIT="30"
BOM_PAGADOR_MIN_ON_TIME_PAYMENTS="3"

# Fonte de Dados ("mock", "folder", ou "nex_web")
DATA_SOURCE_MODE="mock"

# Caminho da pasta monitorada (quando DATA_SOURCE_MODE="folder")
EXPORT_FOLDER_PATH="./dados_nex"

# Credenciais Somente-Leitura para Nex na Web (quando DATA_SOURCE_MODE="nex_web")
NEX_WEB_BASE_URL="https://web.nextar.com.br"
NEX_WEB_TOKEN=""
NEX_WEB_EMAIL=""
NEX_WEB_PASSWORD=""
# Credencial Basic da integração Nextar (obrigatória para autenticar com e-mail/senha)
NEX_WEB_BASIC_AUTH=""

# Painel Admin Multi-Loja (http://127.0.0.1:8080)
# Token de acesso do painel. Se vazio, um token temporário é gerado a cada inicialização
# e impresso no terminal com o link de acesso.
FALACAIXA_ADMIN_TOKEN=""
# Números de WhatsApp dos Admins de Suporte (podem consultar qualquer loja pelo nome)
FALACAIXA_ADMIN_PHONES=""

# Camada de Notificação (Simulação Local sempre ativa + Webhook opcional)
OUTPUT_DIR="./output/alertas_enviados"
WEBHOOK_URL=""
WEBHOOK_TIMEOUT_SECONDS="10"
